{
  "manifest_version": 3,
  "name": "GPTlagfixer",
  "version": "0.1.1",
  "minimum_chrome_version": "111",
  "description": "Keep only the latest messages rendered in long ChatGPT chats to reduce lag.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "GPTlagfixer",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["src/injected/interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/content/bootstrap.js",
        "src/content/dom.js",
        "src/content/ui.js",
        "src/content/prune.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
